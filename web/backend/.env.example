# Copie as variáveis necessárias para o ambiente de implantação.
# development habilita /api/docs; use production em ambiente público.
APP_ENV=development
# Origens exatas separadas por vírgula; curinga é recusado.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=2048
# Opcionais: o padrão usa models/final, web/backend/data e web/frontend/dist.
# MODEL_DIR=
# DATA_DIR=
# FRONTEND_DIST=
